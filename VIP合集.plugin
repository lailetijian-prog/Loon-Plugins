[Script]
# 单词鸭 VIP
http-response ^https:\/\/zhcn\.api\.wordln\.com\/tomato-word script-path=https://raw.githubusercontent.com/WeiGiegie/666/main/dcy.js, requires-body=true, timeout=10, tag=单词鸭VIP

# 疯狂背单词 VIP
http-response ^https?:\/\/api\.fengkuangapp\.com\/account\/grant\/detail\/info\/ script-path=https://raw.githubusercontent.com/WeiGiegie/666/main/fkbdc.js, requires-body=true, timeout=10, tag=疯狂背单词VIP

# Cake VIP
http-response ^https:\/\/api\.mycake\.me\/app\/start script-path=https://raw.githubusercontent.com/WeiGiegie/666/main/cake.js, requires-body=true, timeout=10, tag=CakeVIP

# 口语星球 VIP
http-response ^https?:\/\/mapi\.kouyuxingqiu\.com\/api\/v2 script-path=https://raw.githubusercontent.com/WeiGiegie/666/main/kyxq.js, requires-body=true, timeout=10, tag=口语星球VIP

# lispod VIP
http-response ^https:\/\/api\.lispod\.cn\/api\/User\/CurrentUser script-path=https://raw.githubusercontent.com/WeiGiegie/666/main/lispod.js, requires-body=true, timeout=10, tag=lispodVIP

# 薄荷 VIP
http-response ^https://du\.baicizhan\.com script-path=https://cdn.jsdelivr.net/gh/liul0ng/quanx@refs/heads/main/bohe.js, requires-body=true, timeout=10, tag=薄荷VIP

# 读手表 insight ProMax
http-response ^https?:\/\/watch\.taotiangou\.cn\/prod-api\/watch\/insight\/userInfo script-path=https://raw.githubusercontent.com/chxm1023/Rewrite/main/insight.js, requires-body=true, timeout=10, tag=读手表insight

[MITM]
hostname = zhcn.api.wordln.com, api.fengkuangapp.com, api.mycake.me, mapi.kouyuxingqiu.com, api.lispod.cn, du.baicizhan.com, watch.taotiangou.cn